<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <!-- Rive 动画视图 - 自动循环播放 -->
    <!-- 注意：riveResource 和 riveStateMachine 在代码中设置，以便先配置字体加载器 -->
    <!-- 宽高由代码动态控制，初始值会被 Activity 覆盖 -->
    <!-- 添加了半透明红色背景以便查看 View 的实际边界 -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/aiGlowRiv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="50dp"
        app:layout_constraintDimensionRatio="h,474:973"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riveFit="FILL"
        tools:riveAutoPlay="true"
        tools:riveResource="@raw/ai_glow"
        tools:riveStateMachine="StateMachine_1" />

    <View
        android:id="@+id/contentV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="13dp"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/aiGlowRiv"
        app:layout_constraintEnd_toEndOf="@+id/aiGlowRiv"
        app:layout_constraintStart_toStartOf="@+id/aiGlowRiv"
        app:layout_constraintTop_toTopOf="@+id/aiGlowRiv" />

    <!-- 控制面板 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Width 控制 -->
        <TextView
            android:id="@+id/widthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Width: 338 (125-474)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecreaseWidth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-" />

            <SeekBar
                android:id="@+id/widthSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="349"
                android:progress="213" />

            <Button
                android:id="@+id/btnIncreaseWidth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <!-- Height 控制 -->
        <TextView
            android:id="@+id/heightLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Height: 332 (120-973)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecreaseHeight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-" />

            <SeekBar
                android:id="@+id/heightSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="853"
                android:progress="212" />

            <Button
                android:id="@+id/btnIncreaseHeight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <!-- 重置按钮 -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="重置" />

        <!-- Fit 模式切换 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fit 模式测试"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFitFill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FILL"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFitContain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="CONTAIN"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFitCover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="COVER"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fitModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="当前模式: COVER"
            android:textColor="#FF0000"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
