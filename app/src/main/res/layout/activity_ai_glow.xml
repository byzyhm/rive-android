<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <!-- Rive 动画视图 - 自动循环播放 -->
    <!-- 注意：riveResource 和 riveStateMachine 在代码中设置，以便先配置字体加载器 -->
    <!-- 宽高由代码动态控制，初始值会被 Activity 覆盖 -->
    <!-- 添加了半透明红色背景以便查看 View 的实际边界 -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/glowContainerCL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <app.rive.runtime.kotlin.RiveAnimationView
            android:id="@+id/aiGlowRiv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:riveFit="FILL"
            tools:riveAutoPlay="true"
            tools:riveResource="@raw/ai_glow"
            tools:riveStateMachine="StateMachine_1" />

        <TextView
            android:id="@+id/contentV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="visible"
            android:background="#FFFFFF"
            android:text="狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢"
            android:textSize="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 控制面板 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Width 控制 -->
        <TextView
            android:id="@+id/widthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Width: 338 (125-474)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecreaseWidth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-" />

            <SeekBar
                android:id="@+id/widthSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="349"
                android:progress="213" />

            <Button
                android:id="@+id/btnIncreaseWidth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <!-- Height 控制 -->
        <TextView
            android:id="@+id/heightLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Height: 332 (120-973)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecreaseHeight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-" />

            <SeekBar
                android:id="@+id/heightSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="853"
                android:progress="212" />

            <Button
                android:id="@+id/btnIncreaseHeight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <!-- Text Length 控制 -->
        <TextView
            android:id="@+id/textLengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Text Length: 0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecreaseTextLength"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-" />

            <SeekBar
                android:id="@+id/textLengthSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100" />

            <Button
                android:id="@+id/btnIncreaseTextLength"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
