<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!--
        关键设计说明：glowRiv 作为 glowContainerCL 的兄弟节点，
        通过约束到 glowContainerCL 的四边来自动跟随其尺寸。
        这样避免了「0dp 子 View 约束到 wrap_content 父容器上下边」的循环依赖问题（会导致高度坍塌）。
        z-order: glowRiv 先声明 → 在下层；glowContainerCL 后声明 → 在上层覆盖。
    -->

    <!-- Rive 发光动画：约束到 glowContainerCL 的边界，自动跟随其宽高，允许拉伸变形 -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/glowRiv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/glowContainerCL"
        app:layout_constraintEnd_toEndOf="@id/glowContainerCL"
        app:layout_constraintStart_toStartOf="@id/glowContainerCL"
        app:layout_constraintTop_toTopOf="@id/glowContainerCL"
        tools:riveAutoPlay="true"
        tools:riveResource="@raw/ai_glow_for_msg_bubble" />

    <!-- 消息气泡容器：高度由 anchorView 的内容撑开 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/glowContainerCL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--
            anchorView 模拟聊天消息气泡，同时驱动 glowContainerCL 的高度。
            四边约束到父容器 + wrap_content 高度 → ConstraintLayout 以此为基准计算 wrap_content。
            上下 margin 为发光动画留出空间，使描边效果可见。
        -->
        <TextView
            android:id="@+id/anchorView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢子呢狗子呢狗子呢狗子呢狗子呢狗子呢狗子呢"
            android:textColor="#333333"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 控制面板：固定在底部 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textLengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Length: 100%"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDecreaseTextLength"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-" />

            <SeekBar
                android:id="@+id/textLengthSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100" />

            <Button
                android:id="@+id/btnIncreaseTextLength"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
